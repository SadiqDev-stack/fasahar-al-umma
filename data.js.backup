    /* ============================================================
       MODULE 4 — DIGITAL SAFETY
       ============================================================ */
    {
      id: "digital-safety",
      order: 4,
      icon: "🔐",
      title_ha: "Kariya da Tsaron Asusu",
      title_en: "Digital Safety",
      desc_ha: "Koyi yadda za ka gane scams, phishing da fake offers, ka kare passwords da accounts, sannan ka kiyaye bayananka.",
      desc_en: "Learn how to identify scams, phishing and fake offers, protect passwords and accounts, and keep your personal information safe.",
      examPassMark: 70,

      lessons: [

        /* ---------------- SAFE LESSON 1 ---------------- */
        {
          id: "safe-l1",
          order: 1,
          title_ha: "Gane Zamba",
          title_en: "Spotting Scams",
          video: "",

          read_ha:
            "Zamba, wato **scam**, ita ce lokacin da wani ya yi ƙoƙarin yaudararka domin ya karɓi kuɗinka, bayananka, account ɗinka ko wani abu mai daraja.\n\n" +

            "Scammers suna amfani da waya, WhatsApp, SMS, email, Facebook, Instagram, websites da kuma kira.\n\n" +

            "**Wasu alamun scam:**\n" +
            "- An ce ka ci babban prize alhali ba ka shiga wata competition ba.\n" +
            "- An matsa maka ka yi gaggawa.\n" +
            "- An nemi OTP, PIN ko password.\n" +
            "- An turo maka suspicious link.\n" +
            "- An yi alkawarin kuɗi mai yawa cikin sauƙi ba tare da bayani mai kyau ba.\n" +
            "- An ce ka biya kuɗi kafin a ba ka wata dama ba tare da ka tabbatar da organization ba.\n" +
            "- Account ɗin da yake magana da kai yana kama da official account amma yana da unusual username.\n\n" +

            "**Phishing:**\n" +
            "Phishing wata hanya ce da scammer ke amfani da fake message ko fake website domin ya sa ka ba shi login details ko wasu bayanai.\n\n" +

            "**Misali:**\n" +
            "Za ka iya samun saƙo:\n" +
            "\"Your bank account will be blocked today. Click here to verify.\"\n\n" +
            "Kada ka firgita ka danna. Ka shiga bank app ko official website ta hanyar da ka saba amfani da ita, ko ka kira official customer service.\n\n" +

            "**Gaggawa tana daga cikin dabarar scammers.**\n" +
            "Idan mutum yana cewa \"ka yi yanzu-yanzu ko opportunity ta ƙare\", ka dakata. Ka bincika kafin ka yi wani abu.\n\n" +

            "**Ka yi amfani da dokar STOP:**\n" +
            "- **S — Stop:** Ka dakata.\n" +
            "- **T — Think:** Ka yi tunani.\n" +
            "- **O — Observe:** Ka duba source, link da wanda ya turo.\n" +
            "- **P — Proceed carefully:** Ka ci gaba ne kawai bayan ka tabbatar.\n\n" +

            "Kada ka ji kunya idan ka yi kuskure. Idan ka fahimci cewa ka ba scammer wani muhimmin bayani, ka ɗauki mataki da wuri: canza password, tuntubi banki ko service ɗin da abin ya shafa, sannan ka yi report idan ya dace.",

          read_en:
            "A **scam** is an attempt to trick you into giving away money, personal information, account access, or something valuable.\n\n" +

            "Scammers use phones, WhatsApp, SMS, email, Facebook, Instagram, websites, and phone calls.\n\n" +

            "**Common warning signs:**\n" +
            "- You suddenly won a prize you never entered.\n" +
            "- Someone pressures you to act immediately.\n" +
            "- Someone asks for your OTP, PIN, or password.\n" +
            "- You receive a suspicious link.\n" +
            "- You are promised a large amount of money with little explanation.\n" +
            "- You are asked to pay before receiving an opportunity without being able to verify the organization.\n" +
            "- An account looks official but has an unusual username or other warning signs.\n\n" +

            "**Phishing:**\n" +
            "Phishing is when a scammer uses a fake message or website to trick you into giving away login details or other information.\n\n" +

            "**Example:**\n" +
            "You may receive:\n" +
            "\"Your bank account will be blocked today. Click here to verify.\"\n\n" +
            "Do not panic and click. Open your banking app or official website through the normal method you use, or contact official customer service.\n\n" +

            "**Urgency is a common scam technique.**\n" +
            "If someone says \"act now or you will lose the opportunity,\" stop and verify first.\n\n" +

            "**Use the STOP rule:**\n" +
            "- **S — Stop:** Pause.\n" +
            "- **T — Think:** Think about what is happening.\n" +
            "- **O — Observe:** Check the source, link, and sender.\n" +
            "- **P — Proceed carefully:** Continue only after verification.\n\n" +

            "Do not be ashamed if you make a mistake. If you realize that you have shared important information with a scammer, act quickly: change the password, contact the bank or affected service, and report the incident when appropriate.",

          quiz: {
            question_ha: "Wanne daga cikin waɗannan alama ce mai ƙarfi ta scam?",
            question_en: "Which of these is a strong warning sign of a scam?",
            options: [
              { text_ha: "An matsa maka ka yi gaggawa kuma an nemi OTP", text_en: "You are pressured to act quickly and asked for an OTP", correct: true },
              { text_ha: "An gaishe ka", text_en: "Someone greeted you", correct: false },
              { text_ha: "Ka karanta labari", text_en: "You read an article", correct: false },
              { text_ha: "Ka kalli video", text_en: "You watched a video", correct: false }
            ],
            explanation_ha: "Matsin lamba, gaggawa da neman OTP suna daga cikin manyan alamun scam.",
            explanation_en: "Pressure, urgency, and requests for OTPs are common scam warning signs."
          }
        },


        /* ---------------- SAFE LESSON 2 ---------------- */
        {
          id: "safe-l2",
          order: 2,
          title_ha: "Password da 2FA",
          title_en: "Passwords & 2FA",
          video: "",

          read_ha:
            "Password shi ne ɗaya daga cikin manyan makullan account ɗinka. Idan mutum ya samu password ɗinka, zai iya ƙoƙarin shiga account ɗinka. Saboda haka password ba abin wasa ba ne.\n\n" +

            "**Abin da ya sa password yake da rauni:**\n" +
            "- 123456\n" +
            "- password\n" +
            "- sunanka kawai\n" +
            "- lambar waya\n" +
            "- ranar haihuwa\n" +
            "- password ɗaya a duk accounts\n\n" +

            "Waɗannan abubuwa suna da sauƙin hasashe ko kuma ana iya samun wasu daga cikin su daga social media.\n\n" +

            "**Password mai kyau:**\n" +
            "Ka yi amfani da password mai tsawo kuma mai wahalar hasashe. Idan service ɗin yana ba da damar amfani da passphrase, zaka iya haɗa kalmomi da numbers/symbols cikin hanyar da za ka iya tunawa amma ba ta da sauƙin hasashe.\n\n" +

            "**Kada ka adana password a inda kowa zai gani.**\n" +
            "Idan kana da passwords da yawa, password manager daga trusted provider na iya taimaka maka. Muhimmin abu shi ne ka kare master password ɗin sosai.\n\n" +

            "**Menene 2FA?**\n" +
            "2FA na nufin Two-Factor Authentication. Yana ƙara wani mataki na tabbatar da kai bayan password.\n\n" +

            "Misali, bayan ka saka password, service na iya neman code daga authenticator app ko wani approved verification method.\n\n" +

            "**Me ya sa 2FA yake da muhimmanci?**\n" +
            "Idan wani ya gano password ɗinka, 2FA na iya ƙara wani shinge kafin a shiga account.\n\n" +

            "**Ka tuna:**\n" +
            "2FA ba ya nufin ka ba kowa verification code. Idan wani ya ce zai taimaka maka kuma ya nemi code ɗin da aka aiko maka, ka dakata ka tabbatar da abin da yake faruwa.\n\n" +

            "Ka fara da accounts masu muhimmanci: email, banking, social media da sauran accounts da suke ɗauke da bayananka.",

          read_en:
            "A password is one of the main keys protecting an account. If someone obtains your password, they may attempt to access your account.\n\n" +

            "**Weak password examples:**\n" +
            "- 123456\n" +
            "- password\n" +
            "- Only your name\n" +
            "- Your phone number\n" +
            "- Your birth date\n" +
            "- The same password everywhere\n\n" +

            "These can be easy to guess or may be discovered from information you share publicly.\n\n" +

            "**A stronger password:**\n" +
            "Use a longer password that is difficult to guess. If a service supports passphrases, combining several words with other characters can make a memorable but stronger password.\n\n" +

            "**Do not leave passwords where others can see them.**\n" +
            "If you have many passwords, a password manager from a trusted provider can help. Protect the master password carefully.\n\n" +

            "**What is 2FA?**\n" +
            "2FA means Two-Factor Authentication. It adds another verification step after your password.\n\n" +

            "For example, after entering your password, a service may ask for a code from an authenticator app or another approved verification method.\n\n" +

            "**Why is 2FA important?**\n" +
            "If someone discovers your password, 2FA can provide another barrier before they access your account.\n\n" +

            "**Remember:**\n" +
            "2FA does not mean you should give verification codes to other people. If someone says they are helping you and asks for a code sent to you, stop and verify what is happening.\n\n" +

            "Start with important accounts such as email, banking, social media, and other accounts containing sensitive information.",

          quiz: {
            question_ha: "Menene babban amfanin 2FA?",
            question_en: "What is the main benefit of 2FA?",
            options: [
              { text_ha: "Yana ƙara wani mataki na tsaro", text_en: "It adds another layer of security", correct: true },
              { text_ha: "Yana ƙara battery", text_en: "It increases battery", correct: false },
              { text_ha: "Yana sa internet ya yi sauri", text_en: "It makes internet faster", correct: false },
              { text_ha: "Yana share account", text_en: "It deletes the account", correct: false }
            ],
            explanation_ha: "2FA yana ƙara wani mataki na tabbatar da kai bayan password.",
            explanation_en: "2FA adds another verification step after your password."
          }
        },


        /* ---------------- SAFE LESSON 3 ---------------- */
        {
          id: "safe-l3",
          order: 3,
          title_ha: "OTP da PIN",
          title_en: "OTP & PIN Safety",
          video: "",

          read_ha:
            "OTP da PIN suna da muhimmanci sosai saboda ana iya amfani da su wajen tabbatar da identity ko kammala wani transaction.\n\n" +

            "**OTP — One-Time Password/Code**\n" +
            "OTP code ne na wucin gadi da ake samarwa ko aika maka domin tabbatar da wani aiki. Yawanci yana aiki na ɗan lokaci ko don wani transaction.\n\n" +

            "**PIN — Personal Identification Number**\n" +
            "PIN lamba ce ta sirri da ake amfani da ita a wasu services, kamar katin ATM ko wasu financial services.\n\n" +

            "**Babbar doka:**\n" +
            "**Kada ka ba kowa OTP ko PIN ɗinka.**\n\n" +

            "Ko mutum ya ce shi bank staff ne, customer support ne, agent ne ko wani official ne, kada ka ba shi sirrin login ɗinka ko verification code. Idan kana shakku, ka rufe conversation ɗin ka tuntubi organization ɗin ta official number ko official app/website.\n\n" +

            "**Misalin scam:**\n" +
            "\"Akwai matsala da account ɗinka. Ka karanta min OTP ɗin da aka aiko maka domin mu gyara account.\"\n\n" +
            "Wannan ya kamata ya sa ka tsaya. Kada ka karanta code ɗin.\n\n" +

            "**Ka duba notification ɗin OTP.**\n" +
            "Wasu OTP messages suna bayyana abin da code ɗin yake amfani da shi. Idan ka sami OTP ba tare da ka fara wani transaction ba, kada ka ba kowa code ɗin. Ka duba account ɗinka ko ka tuntubi service provider.\n\n" +

            "**Idan ka zargi account ɗinka:**\n" +
            "- Canza password idan ya dace.\n" +
            "- Tuntuɓi banki/service provider.\n" +
            "- Duba transactions.\n" +
            "- Block ko report scammer.\n\n" +

            "Sirrin OTP da PIN ya kasance naka. Kada ka ba wani saboda matsin lamba, tsoro ko alkawarin taimako.",

          read_en:
            "OTP and PINs are important because they may be used to verify your identity or authorize transactions.\n\n" +

            "**OTP — One-Time Password/Code**\n" +
            "An OTP is a temporary code generated or sent to you to verify an action. It often works for a limited time or a specific transaction.\n\n" +

            "**PIN — Personal Identification Number**\n" +
            "A PIN is a secret number used by certain services, such as ATM cards and some financial services.\n\n" +

            "**The main rule:**\n" +
            "**Never give your OTP or PIN to anyone.**\n\n" +

            "Even if someone claims to be bank staff, customer support, an agent, or another official, do not give them your secret credentials or verification code. If you are unsure, contact the organization through its official app, website, or verified phone number.\n\n" +

            "**Example scam:**\n" +
            "\"There is a problem with your account. Read the OTP to me so I can fix it.\"\n\n" +
            "Stop. Do not read the code.\n\n" +

            "**Pay attention to OTP messages.**\n" +
            "Some OTP messages explain what the code is being used for. If you receive an OTP without starting an action yourself, do not share it. Check your account or contact the service provider.\n\n" +

            "**If you suspect account compromise:**\n" +
            "- Change the password where appropriate.\n" +
            "- Contact the bank or service provider.\n" +
            "- Review transactions.\n" +
            "- Block or report the scammer.\n\n" +

            "Your OTP and PIN belong to you. Never share them because of pressure, fear, or promises of help.",

          quiz: {
            question_ha: "Idan ka sami OTP ba tare da ka fara wani transaction ba, me ya kamata ka yi?",
            question_en: "If you receive an OTP without starting a transaction, what should you do?",
            options: [
              { text_ha: "Ka aika OTP ga wanda ya tambaye ka", text_en: "Send it to whoever asks", correct: false },
              { text_ha: "Ka kiyaye shi kuma ka bincika account ɗinka ko tuntubi service provider", text_en: "Keep it private and check your account or contact the service provider", correct: true },
              { text_ha: "Ka saka shi a social media", text_en: "Post it on social media", correct: false },
              { text_ha: "Ka aika wa aboki", text_en: "Send it to a friend", correct: false }
            ],
            explanation_ha: "OTP ba a raba shi. Idan ka sami OTP ba tare da ka fara wani aiki ba, bincika account ɗinka kuma tuntubi service provider idan kana da shakku.",
            explanation_en: "Never share an OTP. If you receive one unexpectedly, check your account and contact the service provider if necessary."
          }
        },


        /* ---------------- SAFE LESSON 4 ---------------- */
        {
          id: "safe-l4",
          order: 4,
          title_ha: "Sirrin Bayanai",
          title_en: "Protecting Your Privacy",
          video: "",

          read_ha:
            "Personal data, wato bayanan mutum, na iya zama da amfani ga kai da kuma ga scammers. Saboda haka ya kamata ka fahimci irin bayanan da kake rabawa online.\n\n" +

            "**Misalan bayanai masu muhimmanci:**\n" +
            "- Full name.\n" +
            "- Phone number.\n" +
            "- Email address.\n" +
            "- Home address.\n" +
            "- NIN ko wasu identity information.\n" +
            "- BVN da wasu banking information.\n" +
            "- Bank account details.\n" +
            "- Passwords.\n" +
            "- PINs.\n" +
            "- OTPs.\n" +
            "- Private documents.\n\n" +

            "Ba duk waɗannan bayanai ne suke daidai matakin sirri ba, amma ya kamata ka san lokacin da ya dace ka raba su da kuma wanda ya kamata ka raba wa.\n\n" +

            "**NIN da BVN:**\n" +
            "Wasu official services na iya buƙatar identity information. Wannan ba yana nufin kada ka taɓa amfani da su ba. Abin da ya fi muhimmanci shi ne ka tabbatar da wanda yake nema, dalilin neman bayanin, da hanyar da ake amfani da ita.\n\n" +

            "**Ka guji random requests.**\n" +
            "Idan wani random account ya ce:\n" +
            "\"Aiko min NIN ɗinka domin in tabbatar maka da grant\"\n" +
            "kar ka aika nan take. Ka bincika grant ɗin da organization ɗin ta official channels.\n\n" +

            "**Phone lock:**\n" +
            "Ka yi amfani da screen lock, PIN, password ko biometric idan wayarka tana goyan bayansa. Wannan yana taimakawa idan wayar ta ɓace ko wani ya ɗauke ta.\n\n" +

            "**Public Wi-Fi:**\n" +
            "Ka yi hankali idan kana amfani da public Wi-Fi. Kada ka ɗauka cewa network ɗin duk da yake da suna irin na café ko office to lallai official ne. Ka guji yin sensitive activity a network da ba ka yarda da shi ba idan ba lallai ba.\n\n" +

            "**Privacy yana farawa daga abin da ka zaɓi ka raba.**\n" +
            "Kafin ka aika wani bayani, tambayi kanka: *Me ya sa ake buƙatar wannan? Wanene zai karɓa? Ta wace hanya zan aika?*",

          read_en:
            "Personal data can be valuable to you and to scammers. You should understand what information you share online.\n\n" +

            "**Examples of sensitive or important information:**\n" +
            "- Full name.\n" +
            "- Phone number.\n" +
            "- Email address.\n" +
            "- Home address.\n" +
            "- NIN or other identity information.\n" +
            "- BVN and certain banking information.\n" +
            "- Bank account details.\n" +
            "- Passwords.\n" +
            "- PINs.\n" +
            "- OTPs.\n" +
            "- Private documents.\n\n" +

            "Not all information has the same level of sensitivity, but you should understand when and with whom you are sharing it.\n\n" +

            "**NIN and BVN:**\n" +
            "Some legitimate services may require identity information. That does not mean you should never use such services. The important thing is to verify who is asking, why the information is required, and which channel you are using.\n\n" +

            "**Avoid random requests.**\n" +
            "If a random account says:\n" +
            "\"Send me your NIN so I can verify your grant\"\n" +
            "do not send it immediately. Verify the grant and organization through official channels.\n\n" +

            "**Phone lock:**\n" +
            "Use a screen lock, PIN, password, or biometric security if your phone supports it. This helps protect your information if your phone is lost or someone else gets hold of it.\n\n" +

            "**Public Wi-Fi:**\n" +
            "Be careful when using public Wi-Fi. A network having the name of a café or office does not automatically mean it is official. Avoid sensitive activities on networks you do not trust when possible.\n\n" +

            "**Privacy starts with what you choose to share.**\n" +
            "Before sending information, ask: *Why is this needed? Who will receive it? What channel am I using to send it?*",

          quiz: {
            question_ha: "Me ya kamata ka yi idan wani random account ya nemi NIN ɗinka?",
            question_en: "What should you do if a random account asks for your NIN?",
            options: [
              { text_ha: "Ka aika nan take", text_en: "Send it immediately", correct: false },
              { text_ha: "Ka tabbatar da organization da dalilin neman bayanin", text_en: "Verify the organization and reason for the request", correct: true },
              { text_ha: "Ka saka shi a Status", text_en: "Post it on Status", correct: false },
              { text_ha: "Ka aika wa kowa", text_en: "Send it to everyone", correct: false }
            ],
            explanation_ha: "Kada ka aika identity information ga random account. Ka tabbatar da organization da official channel kafin ka raba bayanin.",
            explanation_en: "Do not send identity information to random accounts. Verify the organization and official channel first."
          }
        }
      ],

      exam: [
        {
          question_ha: "Wanne alama ce ta scam?",
          question_en: "Which is a scam warning sign?",
          options: [
            { text_ha: "Matsin lamba da neman OTP", text_en: "Pressure and a request for an OTP", correct: true },
            { text_ha: "Gaisuwa", text_en: "A greeting", correct: false },
            { text_ha: "Karanta labari", text_en: "Reading an article", correct: false },
            { text_ha: "Kallon video", text_en: "Watching a video", correct: false }
          ],
          explanation_ha: "Matsin lamba da neman OTP suna daga cikin manyan alamun scam.",
          explanation_en: "Pressure and requests for OTPs are common scam warning signs."
        },
        {
          question_ha: "Menene amfanin 2FA?",
          question_en: "What is the benefit of 2FA?",
          options: [
            { text_ha: "Ƙarin tsaro", text_en: "Additional security", correct: true },
            { text_ha: "Ƙarin data", text_en: "More data", correct: false },
            { text_ha: "Ƙarin battery", text_en: "More battery", correct: false },
            { text_ha: "Share account", text_en: "Delete an account", correct: false }
          ],
          explanation_ha: "2FA yana ƙara wani mataki na tabbatar da account.",
          explanation_en: "2FA adds another verification layer to an account."
        },
        {
          question_ha: "Me ya kamata ka yi da OTP?",
          question_en: "What should you do with an OTP?",
          options: [
            { text_ha: "Ka raba shi", text_en: "Share it", correct: false },
            { text_ha: "Ka kiyaye shi sirri", text_en: "Keep it private", correct: true },
            { text_ha: "Ka saka shi online", text_en: "Post it online", correct: false },
            { text_ha: "Ka aika wa aboki", text_en: "Send it to a friend", correct: false }
          ],
          explanation_ha: "OTP sirri ne kuma kada a ba wani.",
